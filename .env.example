# M365 MCP Server — Configuration Template
# Copy this file to .env and fill in your values

# Azure App Registration CLIENT_ID (from portal.azure.com)
CLIENT_ID=your-client-id-here

# Use 'common' to support both personal and work Microsoft accounts
TENANT_ID=common

# Token cache file path (automatically created after first auth)
TOKEN_CACHE_PATH=.token_cache.json

# Local folder where email attachments and binary files will be saved
DOWNLOAD_PATH=/Users/your-username/Downloads/m365-mcp
