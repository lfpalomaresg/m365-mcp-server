# M365 MCP Server — Configuration Template
# Copy this file to .env and fill in your values

# Azure App Registration CLIENT_ID (from portal.azure.com)
CLIENT_ID=your-client-id-here

# Use 'common' to support both personal and work Microsoft accounts
TENANT_ID=common

# Token cache file path (automatically created after first auth).
# RECOMENDADO: ruta ABSOLUTA. Claude Code lanza el server desde un CWD arbitrario, así que
# una ruta relativa puede hacer que no encuentre el token → "No active session found".
# (El código ya resuelve rutas relativas contra la raíz del proyecto como salvaguarda, pero
#  una ruta absoluta es lo más explícito y a prueba de fallos.)
# Ej: TOKEN_CACHE_PATH=/Users/tu-usuario/ruta/al/proyecto/.token_cache.json
TOKEN_CACHE_PATH=.token_cache.json

# Local folder where email attachments and binary files will be saved
DOWNLOAD_PATH=/Users/your-username/Downloads/m365-mcp
